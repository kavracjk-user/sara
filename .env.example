# Copia a .env (que NO se sube a Git) y cambia los valores.
# No uses el carácter $ en las claves: Docker Compose lo interpreta.
POSTGRES_USER=sara
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=sara
# Dónde escucha PostgreSQL para el backend (Compose lo publica solo en 127.0.0.1).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# ---- Wazuh del laboratorio (fase 1, lab/wazuh) ----
# Claves de administración: las usa solo el laboratorio, NUNCA SARA.
WAZUH_ADMIN_PASS=cambia-esta-clave
WAZUH_DASHBOARD_PASS=cambia-esta-clave
# La API de Wazuh exige 8-64 caracteres con mayúscula, minúscula, número y símbolo.
WAZUH_API_PASS=cambia-esta-clave

# Memoria (opcional; estos son los valores por defecto). Ver lab/wazuh/README.md.
# WAZUH_INDEXER_HEAP=1g
# WAZUH_INDEXER_MEM=3g
# WAZUH_MANAGER_MEM=2g
# WAZUH_DASHBOARD_MEM=1g
# WAZUH_AGENTE_MEM=256m

# ---- Lo que usa SARA: usuario de SOLO CONSULTA (RNF-02). Nunca el administrador. ----
WAZUH_INDEXER_URL=https://127.0.0.1:9200
WAZUH_INDEXER_USER=sara_lector
WAZUH_INDEXER_PASS=cambia-esta-clave
WAZUH_CA_CERT=./lab/wazuh/config/wazuh_indexer_ssl_certs/root-ca.pem
# El certificado oficial solo vale para el nombre wazuh.indexer: se valida contra él
# aunque la conexión sea a 127.0.0.1 (ver backend/sara/adaptadores/wazuh/tls.py).
WAZUH_INDEXER_TLS_NOMBRE=wazuh.indexer

# ---- API de SARA (fase 4) ----
# Clave que la interfaz envía en la cabecera X-API-Key. Genera una propia, larga y
# aleatoria (p. ej. python -c "import secrets; print(secrets.token_urlsafe(32))").
API_KEY_SARA=cambia-esta-clave
SARA_API_HOST=127.0.0.1
SARA_API_PORT=8000
SARA_CORS_ORIGEN=http://localhost:5173
